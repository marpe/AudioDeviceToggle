<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- NAudio.WinMM, not the NAudio meta-package: on -windows TFMs the meta-package pulls in WinForms (~14 MB). -->
        <PackageReference Include="NAudio.WinMM" Version="2.2.1"/>
        <PackageReference Include="Vanara.PInvoke.CoreAudio" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="sound\*.wav" LogicalName="%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
